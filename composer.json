{
    "name": "ernestdefoe/wardrobe",
    "description": "Wardrobe — install several themes on one Flarum 2 forum and let every member choose the one they see.",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "theme",
        "themes",
        "appearance"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "support": {
        "forum": "https://discuss.flarum.org/d/39845-wardrobe-multi-theme-support-built-using-ai"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Wardrobe\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Wardrobe",
            "category": "feature"
        }
    }
}
